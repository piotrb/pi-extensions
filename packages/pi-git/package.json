{
  "name": "@piotrb/pi-git",
  "version": "0.1.0",
  "description": "Pi extension: structured git tools for staging, committing, and history.",
  "type": "module",
  "license": "MIT",
  "author": "Piotr Banasik",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrb/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/piotrb/pi-extensions/issues"
  },
  "homepage": "https://github.com/piotrb/pi-extensions#readme",
  "engines": {
    "node": ">=22 <25"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extensions/git.ts"
    ],
    "toolMetadata": {
      "git_status": {
        "tags": [
          "readonly"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_add": {
        "tags": [
          "mutating"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_rm": {
        "tags": [
          "mutating"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_mv": {
        "tags": [
          "mutating"
        ],
        "aspects": {
          "source": {
            "mode": "path",
            "fields": [
              {
                "field": "source",
                "mode": "array"
              }
            ]
          },
          "destination": {
            "mode": "path",
            "fields": [
              "destination"
            ]
          }
        }
      },
      "git_restore": {
        "tags": [
          "mutating"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_diff": {
        "tags": [
          "readonly"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_log": {
        "tags": [
          "readonly"
        ],
        "aspects": {
          "path": {
            "mode": "path",
            "fields": [
              {
                "field": "paths",
                "mode": "array"
              }
            ]
          }
        }
      },
      "git_commit": {
        "tags": [
          "mutating"
        ],
        "aspects": {}
      },
      "git_push": {
        "tags": [
          "mutating",
          "network"
        ],
        "aspects": {}
      }
    }
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-git"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@piotrb/pi-extension-utils": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "prettier": "^3.0.0",
    "typebox": "^1.1.38",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.7"
  }
}
