{
  "rules": {
    "pnpm run *": "allow",
    "pnpm install": "allow",
    "pnpm -r run *": "allow",
    "pnpm --filter * run *": "allow",
    "pnpm add *": "allow",
    "pnpm remove *": "allow",
    "pnpm --version": "allow",
    "pnpm turbo *": "allow",
    "pnpm run changeset": "deny",
    "pnpm run version": "deny",
    "pnpm run release": "deny"
  }
}
