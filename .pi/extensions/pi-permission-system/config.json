{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/schemas/permissions.schema.json",

  "permission": {
    "*": "ask",

    "path": {
      "*": "allow",
      "*.env.local": "deny",
      "*.env.*.local": "deny"
    },

    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bfs": "allow",
    "ripgrep": "allow",
    "run": "allow",
    "ask_user_question": "allow",
    "Agent": "allow",
    "todo": "allow",

    "get_subagent_result": "allow",

    "pfs_mv": "allow",
    "pfs_cp": "allow",

    "git_status": "allow",
    "git_diff": "allow",
    "git_log": "allow",
    "git_mv": "ask",
    "git_commit": "ask",

    "edit": {
      "*": "allow",
      "*.env.local": "deny",
      "*.env.*.local": "deny",
      ".pi/*": "ask",
      "packages/*": "allow",
      "*package.json": "ask"
    },
    "write": {
      "*": "allow",
      "*.env.local": "deny",
      "*.env.*.local": "deny",
      ".pi/*": "ask",
      "packages/*": "allow",
      "*package.json": "ask"
    },

    "pfs_unlink": "ask",
    "pfs_rmdir": "ask",

    "mcp": "ask",
    "bash": "deny"
  }
}
