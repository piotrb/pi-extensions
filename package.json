{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Pi extensions: bfs, ripgrep, git, task-runner, context-preloader, pfs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "changeset": "pnpm changeset",
    "version": "pnpm changeset version",
    "release": "pnpm changeset publish",
    "typecheck": "pnpm turbo typecheck",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .eslintcache/",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache/",
    "format": "sh -c 'set -x; pnpm exec prettier --write \"${1:-.}\"' --",
    "format:check": "sh -c 'set -x; pnpm exec prettier --check \"${1:-.}\"' --",
    "test": "pnpm turbo test",
    "test:workspace": "vitest run tests/",
    "check": "pnpm turbo //#format:check //#lint //#test:workspace typecheck test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.0",
    "typebox": "^1.1.38",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.7",
    "yaml": "^2.6.1"
  }
}
